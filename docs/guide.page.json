{
  "schema": "web-ui-page/1",
  "title": "yourself 利用ガイド",
  "theme": "modern",
  "description": "ホスト・OS・ランタイムの事実を読み取り専用で観測し、トラブル対応や AI への文脈として貼れる形で出します。",
  "icon": "./icon.png",
  "favicon": "./favicon.png",
  "blocks": [
    {
      "type": "badges",
      "items": [
        "📄 単一ファイル",
        "🧰 標準ライブラリのみ",
        "🐍 Python 3.11+",
        "👀 読み取り専用"
      ]
    },
    {
      "type": "tabs",
      "id": "guide",
      "tabs": [
        {
          "label": "🧩 機能一覧",
          "blocks": [
            {
              "type": "section",
              "title": "📥 取得",
              "blocks": [
                {
                  "type": "text",
                  "text": "1 ファイルを置くだけで動きます（pip 不要）。"
                },
                {
                  "type": "output",
                  "text": "curl -fsSLO https://raw.githubusercontent.com/myon-bioinformatics/yourself/main/yourself.py"
                }
              ]
            },
            {
              "type": "section",
              "title": "▶️ 実行",
              "blocks": [
                {
                  "type": "card",
                  "title": "🖥️ 環境をひと目で",
                  "text": "引数なしで、OS・Python・ツール・ディスク・ネットワークを 1 行ずつ出します。",
                  "blocks": [
                    {
                      "type": "output",
                      "text": "$ python yourself.py"
                    }
                  ]
                },
                {
                  "type": "card",
                  "title": "🤏 最小",
                  "text": "OS とランタイムだけ。",
                  "blocks": [
                    {
                      "type": "output",
                      "text": "$ python yourself.py --minimal\nos: Linux 6.18.44-fc-v378 x86_64\npython: CPython 3.13.18 64bit"
                    }
                  ]
                },
                {
                  "type": "card",
                  "title": "🧾 形式を選ぶ",
                  "text": "text / markdown / json。",
                  "blocks": [
                    {
                      "type": "output",
                      "text": "$ python yourself.py --format json --minimal\n{\n  \"directory\": null,\n  \"host\": null,\n  \"os\": {\n    \"machine\": \"x86_64\",\n…"
                    }
                  ]
                },
                {
                  "type": "card",
                  "title": "🙈 ネットワークを省く",
                  "text": "ホスト名・アドレス・経路・DNS を出しません。",
                  "blocks": [
                    {
                      "type": "output",
                      "text": "$ python yourself.py --no-network"
                    }
                  ]
                }
              ]
            },
            {
              "type": "section",
              "title": "🐍 Python から呼ぶ",
              "blocks": [
                {
                  "type": "output",
                  "text": "python -c 'import yourself; print(yourself.collect())'"
                }
              ]
            }
          ]
        },
        {
          "label": "🔬 検証ガイド",
          "blocks": [
            {
              "type": "runbook",
              "id": "verify",
              "books": [
                {
                  "label": "🐍 python",
                  "intro": "🤖 のついた手順は CI で実際に動かし、出た結果をそのまま載せています。",
                  "runbook": {
                    "key": "yourself/python",
                    "steps": [
                      {
                        "id": "get",
                        "title": "📥 ファイルを置く",
                        "command": "curl -fsSLO https://raw.githubusercontent.com/myon-bioinformatics/yourself/main/yourself.py",
                        "needs": "🌐 ネットワーク"
                      },
                      {
                        "id": "minimal",
                        "title": "🤏 最小",
                        "command": "python yourself.py --minimal",
                        "run": true
                      },
                      {
                        "id": "json",
                        "title": "🧾 形式を選ぶ",
                        "command": "python yourself.py --format json --minimal",
                        "run": true
                      },
                      {
                        "id": "offline",
                        "title": "🙈 ネットワークを省く",
                        "command": "python yourself.py --no-network",
                        "run": true
                      }
                    ]
                  }
                },
                {
                  "label": "⚡ uv",
                  "intro": "uv があれば Python の版を気にせず動きます。",
                  "runbook": {
                    "key": "yourself/uv",
                    "steps": [
                      {
                        "id": "get",
                        "title": "📥 ファイルを置く",
                        "command": "curl -fsSLO https://raw.githubusercontent.com/myon-bioinformatics/yourself/main/yourself.py",
                        "needs": "🌐 ネットワーク"
                      },
                      {
                        "id": "minimal",
                        "title": "🤏 最小",
                        "command": "uv run --no-project python yourself.py --minimal",
                        "run": true
                      }
                    ]
                  }
                }
              ]
            }
          ]
        },
        {
          "label": "🎞 GIF デモ",
          "blocks": [
            {
              "type": "text",
              "text": "🎞 まだ GIF はありません。ブラウザテストや実行の様子を GIF にしたら、ここに並びます。",
              "muted": true
            }
          ]
        }
      ]
    },
    {
      "type": "section",
      "title": "🔗 リンク",
      "blocks": [
        {
          "type": "links",
          "items": [
            {
              "label": "📦 リポジトリ",
              "href": "https://github.com/myon-bioinformatics/yourself"
            },
            {
              "label": "📖 README",
              "href": "https://github.com/myon-bioinformatics/yourself#readme"
            },
            {
              "label": "📄 yourself.py",
              "href": "https://github.com/myon-bioinformatics/yourself/blob/main/yourself.py"
            },
            {
              "label": "📐 設計",
              "href": "https://github.com/myon-bioinformatics/yourself/blob/main/docs/design.md"
            }
          ]
        }
      ]
    }
  ]
}
